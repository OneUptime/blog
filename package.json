{
  "name": "oneuptime-blog",
  "version": "1.0.0",
  "description": "OneUptime Blog utilities",
  "scripts": {
    "generate-social-image": "npx ts-node src/scripts/generate-social-image.ts",
    "regenerate-all-social-images": "find posts -name 'social-media.png' -delete && npx ts-node src/scripts/generate-social-image.ts --all",
    "validate": "npx ts-node src/scripts/validate-blogs.ts",
    "fix": "npm run validate",
    "build": "tsc",
    "generate-social-image:js": "node dist/scripts/generate-social-image.js",
    "validate:js": "node dist/scripts/validate-blogs.js",
    "validate-posts": "npx ts-node src/scripts/validate-posts.ts",
    "validate-posts:codex": "npx ts-node src/scripts/validate-posts.ts --codex",
    "count": "echo \"Total blogs: $(node -e \"console.log(require('./Blogs.json').length)\")\"",
    "count-validation": "npx ts-node src/scripts/count-validation.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.65"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
